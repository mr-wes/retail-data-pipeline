# Local development configuration template.
# Copy this file to .env and replace placeholders before starting the project.

# Docker Compose
COMPOSE_PROJECT_NAME=03_retail_data_pipeline

# Windows host path to this project directory.
# Replace with the actual path on your computer.
PROJECT_HOST_DIR=C:/path/to/03_retail_data_pipeline

# Docker network created by Docker Compose.
DOCKER_NETWORK_NAME=03_retail_data_pipeline_default

# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=airflow

# Airflow database connection
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Airflow administrator
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Fernet key: only configure this if Airflow is wired to use it.
# Never replace an existing key without checking the existing database.
# AIRFLOW_FERNET_KEY=GENERATE_A_VALID_FERNET_KEY
